{
  "name": "koka-sija",
  "version": "1.0.0",
  "description": "Koka sijas nestspējas aprēķins (Electron + Vue 3 + three.js + Node.js)",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "vite": "vite",
    "dev": "concurrently -k \"npm:server\" \"npm:vite\" \"wait-on tcp:5173 tcp:3000 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && concurrently -k \"npm:server\" \"wait-on tcp:3000 && electron .\""
  },
  "dependencies": {
    "better-sqlite3": ">=11.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "three": "^0.170.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
